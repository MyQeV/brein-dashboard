# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------

# Secret for signing JWT tokens. Generate with: openssl rand -hex 32
BREIN_SECRET_KEY=

# PostgreSQL connection URL (asyncpg driver). For tests use .../brein_test
DATABASE_URL=postgresql+asyncpg://brein:password@localhost:5432/brein  # pragma: allowlist secret

# -----------------------------------------------------------------------------
# First-time setup
# -----------------------------------------------------------------------------

# If set and no users exist, first run creates an admin account automatically
# BREIN_ADMIN_USERNAME=admin
# BREIN_ADMIN_PASSWORD=your-secure-password

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------

# Timezone for both containers (default: UTC). Set to your local timezone.
TZ=Europe/Amsterdam

# Access token lifetime in minutes (default: 30)
# BREIN_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh token lifetime in days (default: 30)
# BREIN_REFRESH_TOKEN_EXPIRE_DAYS=30

# Set to 1 to disable rate limiting (e.g. for local dev)
# BREIN_DISABLE_RATE_LIMIT=1

# Set to 1 to enable uvicorn --reload and other dev-mode behaviors
# BREIN_DEV=1

# Host paths for Docker volume mounts
POSTGRES_DATA_DIR=./data/postgres
BREIN_DATA_DIR=./data/brein


# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# BREIN_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Advanced (rarely changed)
# -----------------------------------------------------------------------------

# BREIN_REFRESH_TOKEN_EXPIRE_DAYS_SESSION=7   # Refresh lifetime when "Remember me" is off
# BREIN_FORCE_HTTPS=1                         # Redirect HTTP → HTTPS behind a reverse proxy

# Default intervals for the background tasks, in seconds. These seed the
# scheduled_tasks table the first time it is written and nothing after that —
# once an install has booted, change an interval on the /settings/tasks page
# instead, which is what the runner actually reads.
# BREIN_EMBY_ACTIVITY_SYNC_INTERVAL_SECONDS=60
# BREIN_USERS_SYNC_INTERVAL_SECONDS=60
# BREIN_PLEX_USERS_SYNC_INTERVAL_SECONDS=600
# BREIN_ITEMS_SYNC_INTERVAL_SECONDS=3600
# BREIN_SABNZBD_SERVER_STATS_INTERVAL_SECONDS=3600

# Emby item-cache tuning
# BREIN_EMBY_ITEM_CACHE_MAX_PER_RUN=200
# BREIN_EMBY_ITEM_CACHE_BATCH_SIZE=50
# BREIN_EMBY_ITEM_CACHE_BATCH_DELAY_SECONDS=0.5

# Host port for the web interface. The container always listens on 3000; this
# is only the host side. Defaults to 3100 because 3000 is commonly taken.
# BREIN_FRONTEND_PORT=3100

# Database backups. Must stay under the mounted data volume (/app/data) or
# backups are destroyed by the next image rebuild.
# BREIN_BACKUP_DIR=/app/data/backups

# Log file tuning
# BREIN_LOG_DIR=/app/data/logs
# BREIN_LOG_FILE=brein.log
# BREIN_LOG_RETENTION_DAYS=30
# BREIN_LOG_ROTATE_UTC=0

# --- Behind a reverse proxy ---------------------------------------------------
# Comma-separated CIDRs whose X-Forwarded-For / X-Forwarded-Host may be trusted.
# Empty by default, and that default is the safe one.
#
# Trusting a proxy means believing the client IP it asserts, so it is only
# safe for a proxy that appends its own view of the peer to X-Forwarded-For —
# nginx, Caddy and Traefik do; the frontend container's rewrite proxy does
# not forward the header at all. Trusting a range that anyone can reach the
# API from lets a client choose its own rate-limit key by setting the header,
# which turns the ten-attempts-per-minute limit on /token into no limit.
#
# The cost of leaving it empty: every request through the bundled frontend
# looks like it comes from that container, so the login and refresh limits
# are shared rather than per user, and last_login_ip records the proxy.
# Set it to your own proxy's address when you have one.
# BREIN_TRUSTED_PROXIES=10.0.1.5/32

# Send cookies only over HTTPS. Leave unset for plain-HTTP LAN use.
# BREIN_COOKIE_SECURE=1

# Database connection pool.
# BREIN_DB_POOL_SIZE=10
# BREIN_DB_MAX_OVERFLOW=20

# How often the dashboard snapshot tables are rebuilt, in seconds.
# BREIN_SNAPSHOT_REBUILD_INTERVAL_SECONDS=900

# Postgres credentials used by docker-compose.yml. DATABASE_URL above is
# ignored under compose: it is composed from these instead.
# POSTGRES_USER=brein
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=brein
